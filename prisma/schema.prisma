datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id               String    @id @default(cuid())
  sku              String?   @unique
  title            String
  slug             String    @unique
  description      String
  pricePKR         Float
  compareAtPrice   Float?
  category         String
  categoryId       String?
  categoryRel      Category? @relation(fields: [categoryId], references: [id])
  showOnHome       Boolean   @default(true)
  showOnHanger     Boolean   @default(true)
  hangerOrder      Int       @default(0)
  sizes            String    @default("[\"S\",\"M\",\"L\",\"XL\"]") // JSON array of sizes
  stock            Int       @default(0)
  images           String    @default("[]") // JSON array of image URLs
  cutoutImages     String    @default("[]") // JSON array of transparent cutout image URLs
  featured         Boolean   @default(false)
  status           String    @default("ACTIVE") // ACTIVE, DRAFT, SOLD_OUT, ARCHIVED
  syncSource       String    @default("manual") // "manual" | "google_sync"
  externalRowHash  String?
  syncedImageMeta  String?   // JSON tracking Drive fileId, fileName, modifiedTime, backdropPresetHash
  lastSyncedAt     DateTime?
  soldOutAt        DateTime?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, showOnHome])
  @@index([status, showOnHanger])
  @@index([status, soldOutAt])
  @@index([categoryId])
  @@index([createdAt])
}

model SyncLog {
  id               String   @id @default(cuid())
  triggerType      String   // "auto" | "manual" | "webhook"
  status           String   // "success" | "partial" | "error"
  productsCreated  Int      @default(0)
  productsUpdated  Int      @default(0)
  productsArchived Int      @default(0)
  imagesSynced     Int      @default(0)
  message          String
  details          String?  // JSON
  createdAt        DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  slotName  String   // e.g. "hero", "editorial_spotlight", "announcement"
  title     String
  subtitle  String?
  imagePath String
  ctaText   String?
  ctaLink   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique
  customerName         String
  phone                String
  city                 String
  address              String
  items                String    // JSON array of item details
  totalPKR             Float
  status               String    @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  confirmationState    String    @default("AWAITING_CONFIRMATION") // AWAITING_CONFIRMATION, CONFIRMED_BY_CUSTOMER, CHECKING_MORE, CANCELLED_BY_CUSTOMER
  customerQuizReplyAt  DateTime?
  trackingNumber       String?
  paymentMethod        String    @default("COD") // COD (Cash On Delivery), JAZZCASH, EASYPAISA
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([confirmationState])
  @@index([createdAt])
}

model WhatsAppLog {
  id             String   @id @default(cuid())
  orderId        String?
  direction      String   // "OUTBOUND" | "INBOUND"
  recipientType  String   // "ADMIN" | "CUSTOMER"
  phone          String
  customerName   String?
  eventType      String   // "ADMIN_NEW_ORDER" | "CUSTOMER_ORDER_QUIZ" | "QUIZ_REPLY" | "STATUS_UPDATE"
  messageBody    String
  providerStatus String   @default("SIMULATED") // "SENT" | "SIMULATED" | "FAILED"
  rawPayload     String?  // JSON
  createdAt      DateTime @default(now())

  @@index([phone])
  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model CallLog {
  id                 String   @id @default(cuid())
  callerPhone        String
  callerName         String?
  callType           String   @default("OFF_HOURS_AI") // "OFF_HOURS_AI" | "SIMULATED"
  durationSeconds    Int      @default(0)
  intent             String   @default("GENERAL") // "ORDER_STATUS" | "PRODUCT_INQUIRY" | "NEW_ORDER" | "CALLBACK_REQUEST" | "GENERAL"
  relatedOrderNumber String?
  aiSummary          String
  transcript         String   @default("[]") // JSON array of { role: "agent" | "caller", text: string, time: string }
  callbackRequested  Boolean  @default(false)
  callbackStatus     String   @default("PENDING") // "PENDING" | "DONE"
  createdAt          DateTime @default(now())

  @@index([callerPhone])
  @@index([callbackRequested, callbackStatus])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
